# Plantilla commiteable — reemplaza CHANGE_ME por los secretos reales.
# El archivo real (.env, gitignored) se crea MANUAL en el VPS:
#   /srv/infra/inmobitwo/backend-inmobitwo/.env

# App
PORT=3001
NODE_ENV=production

# Postgres central del VPS (red docker central_network)
DB_HOST=postgres_central
DB_PORT=5432
DB_USER=adminst
DB_PASSWORD=CHANGE_ME
DB_NAME=inmobitwo

# CORS: dominio del frontend en producción
FRONTEND_URL=https://inmobitwo.seventwo.tech

# JWT (copiar los mismos de local para no invalidar sesiones, o rotarlos)
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
API_SECRET_KEY=CHANGE_ME

# AWS S3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=seventwo
AWS_URL=https://seventwo.us-east-1.amazonaws.com/
AWS_BUCKET_SUBFOLDER=inmobitwo

# Brevo SMTP
BREVO_SMTP_EMAIL=CHANGE_ME
BREVO_SMTP_PASS=CHANGE_ME
BREVO_EMAIL_INFO=info@seventwo.tech
BREVO_EMAIL_SUPPORT=support@seventwo.tech
BREVO_EMAIL_NO_REPLY=no-reply@seventwo.tech
BREVO_EMAIL_JOBS=jobs@seventwo.tech

# Servicios Rust internos (los resuelve docker compose; NO cambiar hostnames).
# El websocket apunta al socket-core del VPS (127.0.0.1:3005 del host),
# alcanzable desde el contenedor vía host.docker.internal (extra_hosts en compose).
RUST_TRACKING_URL=http://inmobitwo-rust-tracking:3002
RUST_MEDIA_URL=http://inmobitwo-rust-media:3003
RUST_WEBSOCKET_URL=ws://host.docker.internal:3005

# Redis interno (servicio inmobitwo-redis del compose; OJO: localhost NO funciona
# dentro del contenedor). El password es el mismo de REDIS_PASSWORD, URL-encoded
# (%40 = @, %23 = #) porque va dentro de una URL.
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME_URL_ENCODED@inmobitwo-redis:6379

# IA (DeepSeek)
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Vistas — token de ficha HMAC (Fase 3). Secreto NUEVO, distinto de JWT_SECRET.
# Debe coincidir con VIEW_TOKEN_SECRET del servicio rust-tracking.
VIEW_TOKEN_SECRET=CHANGE_ME
# Vigencia del token en minutos (debe coincidir con el default de VistaConfig; 60)
VIEW_TOKEN_MAX_AGE_MINUTES=60
# Vistas — sal para hashear IPs (Fase 5, solo la usa rust-tracking; rotable).
VIEW_IP_SALT=CHANGE_ME
# Vistas — secreto interno Node→Rust (lote 3): Rust exige X-Internal-Secret
# en POST /tracking/vista y responde 401 sin él. Mismo valor en ambos.
VIEW_INTERNAL_SECRET=CHANGE_ME
# Cookie de interno (paso8 6b): HMAC propio, NUNCA el de vistas. ≥32 chars.
INTERNO_COOKIE_SECRET=CHANGE_ME
# Log de depuración de IP en registrarVista (paso8 6d): 1 = imprime la IP en
# claro (¡datos personales en logs!); apagado por defecto.
VISTA_DEBUG_IP=0
# Retención de vistas_log (paso8 6f): 1 = job diario borra >13 meses.
# Apagado por defecto.
VISTA_RETENCION_ACTIVA=0
# Vistas — tope diario por IP+inmueble (lote 1 paso3). Lo lee rust-tracking
# (VistaConfig::from_env); default 30 si se omite, 0 = sin tope.
VISTA_DAILY_CAP_PER_IP=30
# Vistas — rate limit por minuto solo para el contador de IP (lote 2 paso4).
# El de visitante sigue en 30 (VISTA_RATE_LIMIT_PER_MINUTE); default 120.
VISTA_RATE_LIMIT_IP_PER_MINUTE=120
# Vistas — capacidad del canal acotado del escritor de log (lote 2 paso4).
# Con try_send: lleno = descarta + cuenta (nunca bloquea); default 10000.
VISTA_LOG_CHANNEL_CAPACITY=10000
# Vistas — tolerancia del chequeo visible_seconds vs servidor (lote 4 punto 2).
# Separada del reloj del token; default 2000 ms.
VISTA_VISIBLE_TOLERANCE_MS=2000
# Vistas — parámetros del algoritmo (defaults de la spec §3, lote 1).
VISTA_MIN_VISIBLE_SECONDS=3
VISTA_DEDUPE_WINDOW_MINUTES=30
VISTA_DAILY_CAP=5
VISTA_RATE_LIMIT_PER_MINUTE=30
VISTA_TOKEN_CLOCK_TOLERANCE_MS=500
VISTA_TIMEZONE=America/Bogota
VISTA_RULES_VERSION=v1
# Listas de bots (lote 5): archivo versionado bot_listas/ua.txt + tabla
# vistas_bot_ips (carga en memoria, recarga 10 min). Ruta sobreescribible:
# BOT_UA_FILE=bot_listas/ua.txt

# Búsquedas guardadas con alertas (migración 009)
CRON_BUSQUEDAS_ENABLED=true
ALERTAS_DRY_RUN=false          # true = solo loguea, no envía ni marca
ALERTAS_MAX_BUSQUEDAS_USUARIO=10
ALERTAS_MAX_ITEMS_EMAIL=10

# Push (apagado por defecto)
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@inmobitwo.com
